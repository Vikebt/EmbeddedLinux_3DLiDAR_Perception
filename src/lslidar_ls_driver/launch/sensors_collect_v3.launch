<launch>
    <!-- 雷达参数 -->
    <arg name="device_ip" default="192.168.1.200"/>     <!--雷达ip-->
    <arg name="msop_port" default="2368"/>              <!--雷达目的数据端口-->
    <arg name="difop_port" default="2369"/>             <!--雷达目的设备端口-->
    <arg name="use_time_service" default="false"/>      <!--是否使用授时,false:使用系统时间-->
    <arg name="packet_rate" default="22440.0"/>         <!--pcap每秒包数，离线解析pcap包时使用-->
    
    <!-- 相机参数 -->
    <arg name="camera_index" default="0"/>              <!--相机设备索引-->
    <arg name="camera_width" default="2048"/>           <!--相机宽度-->
    <arg name="camera_height" default="1536"/>          <!--相机高度-->
    <arg name="camera_fps" default="20"/>               <!--相机FPS-->
    
    <!-- GPS/IMU串口参数 -->
    <arg name="gps_port" default="/dev/wheeltec_gps"/>  <!--GPS串口设备-->
    <arg name="gps_baud_rate" default="9600"/>          <!--GPS波特率-->
    <arg name="imu_port" default="/dev/wheeltec_IMU"/>  <!--IMU串口设备-->
    <arg name="imu_baud_rate" default="460800"/>        <!--IMU波特率-->
    
    <!-- 数据保存路径 -->
    <arg name="save_path" default="/home/nuaa/Ayra/data_lidargpsimu/"/>  <!--数据保存基础路径-->
    
    <!-- 雷达驱动节点 -->
    <node pkg="lslidar_ls_driver" type="lslidar_ls_driver_node" name="lslidar_ls_driver_node" output="screen">
        <!--param name="pcap" value="$(find lslidar_ls_driver)/pcap/xxx.pcap"/-->  <!--离线解析pcap包时取消此行注释-->
        <param name="packet_rate" value="$(arg packet_rate)"/>
        <param name="lidar_ip" value="$(arg device_ip)"/>
        <param name="msop_port" value="$(arg msop_port)"/>
        <param name="difop_port" value="$(arg difop_port)"/>
        <param name="add_multicast" value="false"/>     <!--是否开启组播-->
        <param name="group_ip" value="224.1.1.2"/>      <!--组播ip-->
        <param name="min_range" value="0.5"/>           <!--雷达最小探测距离裁剪-->
        <param name="max_range" value="300"/>           <!--雷达最大探测距离裁剪-->
        <param name="scan_start_angle" value="-60"/>    <!--雷达最小探测角度裁剪-->
        <param name="scan_end_angle" value="60"/>       <!--雷达最大探测角度裁剪-->
        <param name="frame_id" value="laser_link"/>     <!--点云帧id-->
        <param name="pointcloud_topic" value="lslidar_point_cloud"/>    <!--点云话题名称-->
        <param name="packet_loss" value="true"/>       <!--是否开启丢包检测-->
        <param name="use_time_service" value="$(arg use_time_service)"/>
    </node>

    <!-- 多传感器采集系统节点 -->
    <node name="sensors_collect_v3" pkg="lslidar_ls_driver" type="sensors_collect_v3.py" output="screen">
        <!-- 相机参数 -->
        <param name="camera_index" value="$(arg camera_index)"/>
        <param name="camera_width" value="$(arg camera_width)"/>
        <param name="camera_height" value="$(arg camera_height)"/>
        <param name="camera_fps" value="$(arg camera_fps)"/>
        
        <!-- GPS/IMU参数 -->
        <param name="gps_port" value="$(arg gps_port)"/>
        <param name="gps_baud_rate" value="$(arg gps_baud_rate)"/>
        <param name="imu_port" value="$(arg imu_port)"/>
        <param name="imu_baud_rate" value="$(arg imu_baud_rate)"/>
        
        <!-- 数据保存路径 -->
        <param name="save_path" value="$(arg save_path)"/>
    </node>
    
</launch>
